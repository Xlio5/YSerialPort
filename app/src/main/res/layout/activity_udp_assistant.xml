<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_main_root"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:text="UDP 网络助手"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="74dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="协议类型"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_field"
                    android:gravity="center"
                    android:text="UDP"
                    android:textColor="#38BDF8"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:gravity="center_vertical"
                    android:text="本地主机地址"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_field"
                    android:gravity="center"
                    android:text="0.0.0.0"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:gravity="center_vertical"
                    android:text="本地主机端口"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_local_port"
                    android:layout_width="96dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_field"
                    android:gravity="center"
                    android:hint="本地端口"
                    android:inputType="number"
                    android:maxLength="5"
                    android:padding="6dp"
                    android:text="8888"
                    android:textColor="#E2E8F0"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_udp_open"
                    android:layout_width="90dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_button_primary"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="打开 UDP"
                    android:textColor="#0F172A"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="74dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="远程主机"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_target_host"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field"
                    android:hint="例如 10.42.0.158"
                    android:inputType="textNoSuggestions"
                    android:padding="8dp"
                    android:textColor="#E2E8F0"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="18dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text=":"
                    android:textColor="#94A3B8"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/et_target_port"
                    android:layout_width="96dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_field"
                    android:gravity="center"
                    android:hint="端口"
                    android:inputType="number"
                    android:maxLength="5"
                    android:padding="6dp"
                    android:text="8888"
                    android:textColor="#E2E8F0"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cb_hex_display"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:buttonTint="#38BDF8"
                    android:text="HEX显示"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cb_hex_send"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:buttonTint="#38BDF8"
                    android:text="HEX发送"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_count"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:text="S:0  R:0"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_clear"
                    android:layout_width="70dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_button_secondary"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="清数据"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.45"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="2dp"
                    android:paddingBottom="3dp"
                    android:text="UDP 数据"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ScrollView
                    android:id="@+id/sv_log"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_log"
                    android:fillViewport="true">

                    <TextView
                        android:id="@+id/tv_log"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:padding="8dp"
                        android:textColor="#E2E8F0"
                        android:textIsSelectable="false"
                        android:textSize="12sp" />
                </ScrollView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:background="@drawable/bg_panel"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="4dp"
                    android:text="发送 UDP"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_send"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field"
                    android:gravity="top|start"
                    android:hint="HEX: 01 03 00 00 / ASCII: hello"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:minHeight="72dp"
                    android:padding="8dp"
                    android:textColor="#E2E8F0"
                    android:textColorHint="#64748B"
                    android:textCursorDrawable="@null"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_send"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_button_primary"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="发送"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</layout>
