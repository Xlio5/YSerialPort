<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_main_root"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:text="串口转 UDP"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/sp_device"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.4"
                    android:background="@drawable/bg_field" />

                <Spinner
                    android:id="@+id/sp_baud"
                    android:layout_width="110dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_field" />

                <Spinner
                    android:id="@+id/sp_data_bits"
                    android:layout_width="70dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_field" />

                <Spinner
                    android:id="@+id/sp_parity"
                    android:layout_width="92dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_field" />

                <Spinner
                    android:id="@+id/sp_stop_bits"
                    android:layout_width="70dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_field" />

                <Button
                    android:id="@+id/btn_scan"
                    android:layout_width="64dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_button_secondary"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="扫描"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_serial_open"
                    android:layout_width="92dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_button_primary"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="打开串口"
                    android:textColor="#0F172A"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="74dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="协议类型"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_field"
                    android:gravity="center"
                    android:text="UDP"
                    android:textColor="#38BDF8"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:gravity="center_vertical"
                    android:text="本地主机地址"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_field"
                    android:gravity="center"
                    android:text="0.0.0.0"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:gravity="center_vertical"
                    android:text="本地主机端口"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_local_port"
                    android:layout_width="96dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_field"
                    android:gravity="center"
                    android:hint="本地端口"
                    android:inputType="number"
                    android:maxLength="5"
                    android:padding="6dp"
                    android:text="8888"
                    android:textColor="#E2E8F0"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_udp_open"
                    android:layout_width="90dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_button_primary"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="打开 UDP"
                    android:textColor="#0F172A"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="74dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="远程主机"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_target_host"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field"
                    android:hint="例如 10.42.0.158"
                    android:inputType="textNoSuggestions"
                    android:padding="8dp"
                    android:textColor="#E2E8F0"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="18dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text=":"
                    android:textColor="#94A3B8"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/et_target_port"
                    android:layout_width="96dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_field"
                    android:gravity="center"
                    android:hint="端口"
                    android:inputType="number"
                    android:maxLength="5"
                    android:padding="6dp"
                    android:text="8888"
                    android:textColor="#E2E8F0"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cb_serial_to_udp"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:buttonTint="#38BDF8"
                    android:checked="true"
                    android:text="串口-&gt;UDP"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cb_udp_to_serial"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:buttonTint="#38BDF8"
                    android:checked="true"
                    android:text="UDP-&gt;串口"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cb_hex_display"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:buttonTint="#38BDF8"
                    android:text="HEX显示"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_count"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:text="SER R:0 S:0  UDP R:0 S:0"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_clear"
                    android:layout_width="70dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_button_secondary"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="清数据"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/sv_log"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_log"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tv_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="8dp"
                android:textColor="#E2E8F0"
                android:textIsSelectable="false"
                android:textSize="12sp" />
        </ScrollView>
    </LinearLayout>
</layout>
