<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_main_root"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:text="串口连接"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/sp_device"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field" />

                <Button
                    android:id="@+id/btn_scan"
                    android:layout_width="64dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_button_secondary"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="扫描"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_open"
                    android:layout_width="82dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_button_primary"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="打开串口"
                    android:textColor="#0F172A"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/sp_baud"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field" />

                <Spinner
                    android:id="@+id/sp_data_bits"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field" />

                <Spinner
                    android:id="@+id/sp_parity"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1.15"
                    android:background="@drawable/bg_field" />

                <Spinner
                    android:id="@+id/sp_stop_bits"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cb_hex_display"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:buttonTint="#38BDF8"
                    android:checked="true"
                    android:text="HEX显示"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cb_hex_send"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:buttonTint="#38BDF8"
                    android:checked="true"
                    android:text="HEX发送"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_count"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:text="S:0  R:0"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_clear_data"
                    android:layout_width="70dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_button_secondary"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="清数据"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_clear_count"
                    android:layout_width="70dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_button_danger"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="清计数"
                    android:textColor="#FCA5A5"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.45"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="2dp"
                    android:paddingBottom="3dp"
                    android:text="通讯数据"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ScrollView
                    android:id="@+id/sv_log"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_log"
                    android:fillViewport="true">

                <TextView
                    android:id="@+id/tv_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:padding="8dp"
                    android:textColor="#E2E8F0"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
                </ScrollView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:background="@drawable/bg_panel"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:id="@+id/tv_send_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="4dp"
                    android:text="写入数据"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_send"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field"
                    android:gravity="top|start"
                    android:hint="HEX: 01 03 00 00 00 02 / ASCII: AT+PING"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:minHeight="72dp"
                    android:padding="8dp"
                    android:textColor="#E2E8F0"
                    android:textColorHighlight="#334155"
                    android:textColorHint="#64748B"
                    android:textColorLink="#38BDF8"
                    android:textCursorDrawable="@null"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/cb_timed_send"
                        android:layout_width="42dp"
                        android:layout_height="34dp"
                        android:buttonTint="#38BDF8"
                        android:text=""
                        android:textColor="#E2E8F0"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/et_interval"
                        android:layout_width="64dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_field"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="6"
                        android:text="1000"
                        android:textColor="#E2E8F0"
                        android:textCursorDrawable="@null"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btn_send"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_primary"
                        android:backgroundTint="@null"
                        app:backgroundTint="@null"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text="发送"
                        android:textColor="#0F172A"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</layout>
